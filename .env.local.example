# Local development environment for great-pdf-generator.
# Copy to .env.local (gitignored) and adjust, then: ./scripts/dev.sh
#
# scripts/dev.sh sources this file; the binary itself reads plain env vars
# (no dotenv dependency), matching how it runs under systemd / Docker.

# --- required ---------------------------------------------------------------
# Path to a headless Chromium / chrome-headless-shell binary. On macOS a
# Playwright or Puppeteer cache copy works:
CHROMIUM_PATH=/Users/you/Library/Caches/ms-playwright/chromium_headless_shell-1234/chrome-headless-shell-mac-arm64/chrome-headless-shell

PORT=8080
LOG_LEVEL=debug

# --- API key auth (auth-and-tenancy v1) -----------------------------------
# Comma-separated. Any one of these is accepted via `X-API-Key: <key>` or
# `Authorization: Bearer <key>`. Health probes (/livez /readyz /healthz) are
# always exempt.
API_KEYS=local-dev-test-key-not-secret
# Set AUTH_DISABLED=true to run with no key check (local only). If neither
# API_KEYS nor AUTH_DISABLED is set, the server refuses to start.
# AUTH_DISABLED=true

# --- deployment render defaults ------------------------------------------
# The base every request's `options` object is layered on. These mirror
# pdf-service-saas so a repointed saas-backend gets identical output even
# for requests that send no options.
PDF_DEFAULT_PAPER=Letter
PDF_DEFAULT_MARGIN_TOP=0
PDF_DEFAULT_MARGIN_RIGHT=0
PDF_DEFAULT_MARGIN_BOTTOM=10mm
PDF_DEFAULT_MARGIN_LEFT=0
PDF_DEFAULT_PRINT_BACKGROUND=true

# --- render pool --------------------------------------------------------
POOL_SIZE=2
MAX_CONCURRENCY_PER_INSTANCE=6
# JOB_QUEUE_CAPACITY=12

# --- optional: server-side image embedding (options.embedImages) --------
# Off by default. Only enable if callers need it; fetching URLs named in a
# submitted document is SSRF surface, so private/loopback targets are
# refused unless EMBED_IMAGES_ALLOW_PRIVATE=true.
# EMBED_IMAGES_ENABLED=true
# EMBED_IMAGES_ALLOWED_HOSTS=.amazonaws.com,.cloudfront.net
# EMBED_IMAGES_ALLOW_PRIVATE=false

# --- optional: lightweight (WeasyPrint) path ---------------------------
# WEASYPRINT_PATH=/opt/homebrew/bin/weasyprint

SHUTDOWN_GRACE=0s
