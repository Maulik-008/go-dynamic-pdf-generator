# Environment file for the systemd unit.
# Install to /etc/great-pdf-generator.env
#
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell quoting.

# --- required --------------------------------------------------------------
# Path to the Chromium / chrome-headless-shell binary. On Debian/Ubuntu with
# the `chromium` package this is /usr/bin/chromium.
CHROMIUM_PATH=/usr/bin/chromium

# --- server ----------------------------------------------------------------
PORT=8080
LOG_LEVEL=info

# How long readiness reports failure before the listener closes, so load
# balancers stop routing here before in-flight work is drained. Keep
# TimeoutStopSec in the unit comfortably above this plus your longest render.
SHUTDOWN_GRACE=5s

# --- API key auth (required) ---------------------------------------------
# Comma-separated. A request must present one via `X-API-Key: <key>` or
# `Authorization: Bearer <key>`. Health probes (/livez /readyz /healthz) are
# exempt. The process refuses to start if this is empty and AUTH_DISABLED is
# not "true".
API_KEYS=REPLACE_WITH_A_LONG_RANDOM_SECRET
# AUTH_DISABLED=true   # local development only — never in a real deployment

# --- render defaults (deployment-level) --------------------------------
# The base every request's `options` object is layered on. Set to match the
# consuming app so requests that send no options still render correctly.
# For Synectus Medico these mirror pdf-service-saas exactly:
PDF_DEFAULT_PAPER=Letter
PDF_DEFAULT_MARGIN_TOP=0
PDF_DEFAULT_MARGIN_RIGHT=0
PDF_DEFAULT_MARGIN_BOTTOM=10mm
PDF_DEFAULT_MARGIN_LEFT=0
PDF_DEFAULT_PRINT_BACKGROUND=true
# PDF_DEFAULT_LANDSCAPE=false
# PDF_DEFAULT_DISPLAY_HEADER_FOOTER=true
# PDF_DEFAULT_FOOTER_TEMPLATE=<div>...</div>

# --- optional: server-side image embedding (options.embedImages) ------
# Off unless EMBED_IMAGES_ENABLED=true. Fetches URLs named in a submitted
# document, so private/loopback targets are refused unless
# EMBED_IMAGES_ALLOW_PRIVATE=true. Prefer restricting to known hosts.
# EMBED_IMAGES_ENABLED=true
# EMBED_IMAGES_ALLOWED_HOSTS=.amazonaws.com,.cloudfront.net

# --- render pool -----------------------------------------------------------
# Measured finding (docs/research/load-test-results.md): throughput plateaus
# at roughly one Chromium instance per CPU core, so setting POOL_SIZE above
# the core count buys no throughput and adds contention. Start at
# (cores - 1), leaving one core for the Go process and the OS.
POOL_SIZE=3
MAX_CONCURRENCY_PER_INSTANCE=6

# Admission control. Requests beyond (workers + queue) are rejected
# immediately with 503 + Retry-After instead of piling up. Defaults to the
# pool's own concurrent-render capacity when unset.
# JOB_QUEUE_CAPACITY=18

# --- optional: lightweight (WeasyPrint) path -------------------------------
# Leave unset to disable; /v1/pdf/html-lite then returns 503 NOT_CONFIGURED.
# WEASYPRINT_PATH=/usr/bin/weasyprint
# WEASYPRINT_WORKERS=4
# WEASYPRINT_QUEUE_CAPACITY=4
